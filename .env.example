# OpenAI GPT API, no fine-tuning
export OPENAI_API_KEY="<YOUR_OPENAI_API_KEY>"
export OPENAI_MODEL="<YOUR_GPT_MODEL>"   # change to any model available to your account

# Local Qwen same-base ICL/LoRA on AutoDL
# Use the same base checkpoint for qwen_local_icl and qwen_lora.
export QWEN_BASE_MODEL="Qwen/Qwen2.5-7B-Instruct"
export QWEN_CLS_LORA_DIR="qwen_finetune/qwen_lora_cls_auto_loan"
export LOCAL_ICL_ROWS_PER_CALL=6
export LOCAL_ICL_N_EXAMPLES=12

# Optional hosted Qwen API. Not part of the primary same-base comparison.
export DASHSCOPE_API_KEY="<YOUR_DASHSCOPE_API_KEY>"
export QWEN_API_MODEL="qwen-plus"
export DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
